# ==========================================
# MERN Stack Comprehensive .gitignore Template
# ==========================================

# --- Dependencies ---
# Prevents bloated repositories by excluding third-party code
node_modules/
jspm_packages/
.npm/
.eslintcache

# --- Environment Variables & Secrets ---
# NEVER commit these files; they contain sensitive API keys and credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- Production Builds & Compilations ---
# Frontend build folders (React/Vite/Next.js)
build/
dist/
.next/
out/
client/.parcel-cache

# --- Logs & Process Management ---
# Server logs, debug files, and process managers
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids
*.pid
*.seed
*.pid.lock

# --- Testing & Coverage ---
# Excludes testing suites reports and outputs
coverage/
.nyc_output

# --- Database & Cache ---
# Local database locks, socks, and diagnostics (MongoDB/Redis)
*.sock
*.lock
.dccache

# --- IDEs & Editors Configurations ---
# Editor-specific metadata and workspace configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- System & OS-Specific Files ---
# Junk files generated by operating systems
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# --- Optional: Local Uploads ---
# Uncomment below if your app saves user uploads locally instead of using S3/Cloudinary
# server/uploads/
# client/public/uploads/

# Claude Code project instructions (kept local, not published)
CLAUDE.md

.mongo-data


